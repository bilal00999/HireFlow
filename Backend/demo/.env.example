# HireFlow backend — environment template.
# Copy this file to `.env` and fill in real values. `.env` is gitignored;
# NEVER commit real secrets. This template holds placeholders only.

# --- AI (Gemini) ---
GEMINI_API_KEY=

# --- Email (Brevo SMTP) ---
# BREVO_SMTP_LOGIN is your Brevo "SMTP login" (looks like xxxxxx@smtp-brevo.com).
# BREVO_SMTP_KEY   is your Brevo SMTP key (NOT your Brevo account password).
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
# Sender identity — must be a VERIFIED sender in your Brevo account.
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=HireFlow

# --- Cloudinary (file storage: profile images + resumes) ---
# From your Cloudinary dashboard (Settings > API Keys). Keep the API secret
# server-side only — never expose it to the frontend.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
